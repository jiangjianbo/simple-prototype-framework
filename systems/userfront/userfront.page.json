{
  "type": "desktop",
  "id": "userfront-desktop",
  "component": "app-layout",
  "children": [
    {
      "slot": "icon",
      "component": "icon",
      "data": "@/logo.svg",
      "size": "lg"
    },
    {
      "slot": "title",
      "component": "text",
      "data": "@title",
      "title": "用户中心",
      "size": "base",
      "strong": true
    },
    {
      "slot": "menu",
      "component": "nav-menu"
    },
    {
      "slot": "breadcrumb",
      "component": "breadcrumb"
    },
    {
      "slot": "footer",
      "component": "text",
      "text": "用户中心 · 内部原型 v0.1",
      "muted": true
    },
    {
      "slot": "sidebar",
      "component": "card",
      "children": [
        {
          "slot": "header",
          "component": "card-header",
          "children": [
            { "component": "card-title", "text": "小贴士" },
            { "component": "card-description", "text": "使用帮助" }
          ]
        },
        {
          "slot": "default",
          "component": "row",
          "template": "1fr",
          "gap": 12,
          "children": [
            {
              "component": "alert",
              "variant": "info",
              "title": "完善资料",
              "description": "补全部门与职位信息后，审批流程会自动带上你的部门信息。"
            },
            {
              "component": "alert",
              "variant": "success",
              "title": "账号安全",
              "description": "你的账号已开启登录二次验证，最近一次登录来自本机。"
            }
          ]
        }
      ]
    },

    { "$ref": "pages/home.json" },
    { "$ref": "pages/profile.json" },

    {
      "$ref": "pages/orders.json",
      "description": "全部订阅与商城订单（按下单时间倒序）"
    }
  ]
}
