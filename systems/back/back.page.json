                "slot": "default",
                "component": "row",
                "template": "1fr 1fr",
                "children": [
                  {
                    "component": "form-item",
                    "label": "用户名（txtUser）",
                    "children": [
                      { "component": "input", "id": "txtUser", "placeholder": "用户名" }
