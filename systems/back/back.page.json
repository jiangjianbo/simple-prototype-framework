                    "mode": "readonly",
                    "value": {
                      "lock": true,
                      "id": "U-1024",
                      "name": "张伟",
                      "email": "zhangwei@corpsafe.cn",
                      "age": 32,
                      "isActive": true,
                      "createdAt": "2023-06-01"
