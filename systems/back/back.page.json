    "component": "app-layout",
    "children": [
      { "slot": "icon", "component": "icon", "data": "@/brain.svg", "size": "lg" },
      { "slot": "title", "component": "text", "data": "@title", "title": "数据安全大脑", "size": "base", "strong": true },
      { "slot": "menu", "component": "nav-menu" },
      { "slot": "breadcrumb", "component": "breadcrumb" },
      { "slot": "footer", "component": "text", "text": "安全运营中心 · 内部原型 v0.1", "muted": true },

      {
        "slot": "sidebar",
        "component": "card",
        "children": [
          {
            "slot": "header",
            "component": "card-header",
            "children": [
              { "component": "card-title", "text": "安全公告" },
              { "component": "card-description", "text": "由安全管理员发布" }
            ]
          },
          {
            "slot": "default",
            "component": "row",
            "template": "1fr",
            "gap": 12,
            "children": [
              { "component": "alert", "variant": "warning", "title": "季度攻防演练", "description": "11 月 8 日 22:00 - 次日 6:00 进行红蓝对抗，期间部分接口将限流。" },
              { "component": "alert", "variant": "info", "title": "新版本灰度", "description": "审计日志模块灰度发布中，遇到问题请反馈至 #sec-feedback。" },
              {
                "component": "card",
                "children": [
                  {
                    "slot": "default",
                    "component": "row",
                    "template": "1fr",
                    "gap": 10,
                    "children": [
                      { "component": "text", "text": "基线合规率", "muted": true },
                      { "component": "progress", "value": 86 },
                      { "component": "text", "text": "密钥轮转进度", "muted": true },
                      { "component": "progress", "value": 64 }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },

      {
        "type": "page",
        "id": "dashboard",
        "slot": "content",
        "title": "安全概览",
        "description": "数据安全态势总览 · 近 30 天（图表基于 Unovis，shadcn-vue charts 同源底层）",
        "component": "page-view",
        "children": [
          {
            "component": "row",
            "columns": 4,
            "children": [
              { "component": "stat-card", "title": "接入资产", "value": 1284, "delta": "12%", "tone": "up", "icon": "server", "hint": "较上月新增 138 台" },
              { "component": "stat-card", "title": "活跃用户", "value": "86.2%", "delta": "3.1%", "tone": "up", "icon": "users", "hint": "近 7 天日活均值" },
              { "component": "stat-card", "title": "待处理告警", "value": 12, "delta": "-8", "tone": "down", "icon": "bell", "hint": "高风险 3 · 中风险 9" },
              { "component": "stat-card", "title": "综合风险评分", "value": 32, "delta": "良好", "tone": "default", "icon": "gauge", "hint": "0-100，越低越安全" }
            ]
          },
          {
            "component": "row",
            "template": "1.75fr 1fr",
            "children": [
              {
                "component": "card",
                "children": [
                  {
                    "slot": "header",
                    "component": "card-header",
                    "children": [
                      { "component": "card-title", "text": "风险事件趋势" },
                      { "component": "card-description", "text": "高风险 / 中风险事件数量（chart-area）" }
                    ]
                  },
                  {
                    "slot": "default",
                    "component": "chart-area",
                    "data": "/systems/back/data/risk-trend.json",
                    "xKey": "date",
                    "yKeys": ["high", "medium"],
                    "height": 280
                  }
                ]
              },
              {
                "component": "card",
                "children": [
                  {
                    "slot": "header",
                    "component": "card-header",
                    "children": [
                      { "component": "card-title", "text": "告警类型分布" },
                      { "component": "card-description", "text": "本月累计（chart-donut）" }
                    ]
                  },
                  {
                    "slot": "default",
                    "component": "chart-donut",
                    "data": "/systems/back/data/alert-types.json",
                    "categoryKey": "label",
                    "valueKey": "value",
                    "height": 200
                  }
                ]
              }
            ]
          },
          {
            "component": "row",
            "columns": 1,
            "children": [
              {
                "component": "card",
                "children": [
                  {
                    "slot": "header",
                    "component": "card-header",
                    "children": [
                      { "component": "card-title", "text": "本周处置吞吐" },
                      { "component": "card-description", "text": "已处置 / 待处置（chart-bar，多序列堆叠）" }
                    ]
                  },
                  {
                    "slot": "default",
                    "component": "chart-bar",
                    "data": "/systems/back/data/weekly-throughput.json",
                    "xKey": "week",
                    "yKeys": ["resolved", "pending"],
                    "height": 240
                  }
                ]
              }
            ]
          }
        ]
      },

      {
        "type": "page",
        "id": "user-list",
        "slot": "content",
        "title": "用户列表",
        "description": "列出全部的用户信息 · 列由 @@User 元数据自动生成 · 列表只读",
        "component": "page-view",
        "children": [
          {
            "component": "table",
            "title": "全部用户",
            "mode": "readonly",
            "searchable": true,
            "sortable": true,
            "rows": "/systems/back/data/users.json",
            "column": [
              { "component": "field-list", "data": "@@User", "placeholder": "搜索姓名" },
              { "type": "element", "component": "button", "text": "新增用户", "variant": "primary", "@goto": "user-info" }
            ]
          }
        ]
      },

