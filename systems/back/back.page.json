                  {
                    "component": "form-item",
                    "label": "变更说明（txtDescription）",
                    "children": [
                      { "component": "textarea", "id": "txtDescription", "placeholder": "填写变更原因" }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "component": "row",
            "columns": 3,
            "children": [
              { "component": "button", "id": "btnEdit", "text": "编辑", "variant": "outline" },
              { "component": "button", "id": "btnSubmit", "text": "提交审核", "variant": "primary" },
              { "component": "button", "id": "btnSave", "text": "保存修改" }
            ]
          }
        ]
      },

      {
        "type": "page",
        "id": "order-list",
        "slot": "content",
        "title": "订单聚合",
        "description": "TanStack Table 分组聚合按需启用：groupBy=品类 + sum(金额/数量)",
        "component": "page-view",
        "children": [
          {
            "component": "table",
            "title": "全部订单",
            "rows": "/systems/back/data/orders.json",
            "searchable": true,
            "sortable": true,
            "groupBy": "category",
            "aggregations": { "amount": "sum", "qty": "sum" },
            "column": [
              { "field": "id", "label": "订单号" },
              { "field": "product", "label": "商品" },
              { "field": "category", "label": "品类" },
              { "field": "qty", "label": "数量" },
              { "field": "amount", "label": "金额" },
              { "field": "date", "label": "日期" },
              { "field": "status", "label": "状态" }
            ]
          }
        ]
      },

